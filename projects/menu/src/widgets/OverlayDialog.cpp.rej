@@ -400,10 +403,13 @@ void OverlayDialog::currentAccessibilityParts(std::string& context,
     if (!choice.empty())
         summary = choice;
     if (m_accessibilitySpeakPosition && !m_buttons.empty())
-        position = std::to_string(m_selected + 1) + " sur " + std::to_string((int)m_buttons.size());
